#!/usr/bin/env bash
# bin/phx-tournament-ports — Phalanx Duel tournament domains & ports accessibility matrix.
#
# Inspects process socket listeners, local vs LAN interface binding (0.0.0.0 vs 127.0.0.1),
# live TCP/HTTP reachability, macOS firewall rules, and prints the accessibility matrix.
#
# Usage:
#   phx-tournament-ports          # Print formatted terminal accessibility matrix
#   phx-tournament-ports --json   # Output raw accessibility probe data as JSON
#   phx-tournament-ports --help   # Show this help guide

set -euo pipefail

case "${1:-}" in
  -h|--help)
    sed -n '2,10p' "$0" | sed 's/^# *//'
    exit 0
    ;;
esac

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ "${1:-}" == "--json" ]]; then
  exec node --import tsx -e '
    import { runAllEndpointChecks } from "./scripts/tournament/endpoint-accessibility.ts";
    runAllEndpointChecks().then(res => console.log(JSON.stringify(res, null, 2)));
  '
else
  exec node --import tsx -e '
    import { runAllEndpointChecks, renderAccessibilityMatrixTerminal } from "./scripts/tournament/endpoint-accessibility.ts";
    runAllEndpointChecks().then(res => console.log(renderAccessibilityMatrixTerminal(res)));
  '
fi
