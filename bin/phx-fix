#!/usr/bin/env bash
# Phalanx Duel - Repository Asset & Code Sanitizer
# Canonical tool: bin/phx-fix <file_path>
set -euo pipefail

FILE="${1:-}"

if [ -z "$FILE" ]; then
  echo "Usage: bin/phx-fix <file_path>"
  exit 1
fi

if [ ! -f "$FILE" ]; then
  echo "Error: File $FILE not found."
  exit 1
fi

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

echo "🪄 Auto-fixing $FILE..."

case "$FILE" in
  *.ts|*.tsx|*.js|*.jsx)
    pnpm exec eslint --fix "$FILE" 2>/dev/null || npx eslint --fix "$FILE"
    pnpm exec prettier --write "$FILE"
    ;;
  *.md)
    pnpm exec markdownlint-cli2 --fix --config .markdownlint-cli2.jsonc "$FILE" 2>/dev/null || true
    pnpm exec prettier --write "$FILE"
    ;;
  package.json)
    pnpm exec sort-package-json "$FILE" 2>/dev/null || npx sort-package-json "$FILE"
    pnpm exec prettier --write "$FILE"
    ;;
  *.json|*.jsonc|*.yml|*.yaml|*.css|*.html)
    if [[ "$FILE" == *".github/workflows/"* ]] && command -v actionlint >/dev/null 2>&1; then
      actionlint "$FILE"
    fi
    pnpm exec prettier --write "$FILE"
    ;;
  .env*)
    # Strip trailing whitespace and ensure one newline at EOF
    sed -i '' 's/[[:space:]]*$//' "$FILE"
    if [ -n "$(tail -c 1 "$FILE")" ]; then echo "" >> "$FILE"; fi
    ;;
  Dockerfile*)
    # Basic cleanup for Dockerfiles
    sed -i '' 's/[[:space:]]*$//' "$FILE"
    ;;
  *.toml)
    if command -v taplo >/dev/null 2>&1; then
      taplo fmt "$FILE"
    fi
    ;;
  *)
    pnpm exec prettier --write "$FILE" 2>/dev/null || true
    ;;
esac

echo "✅ $FILE sanitized."
