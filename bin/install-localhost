#!/usr/bin/env bash
# bin/install-localhost — serve the local dev stack at:
#   https://play.phalanxduel.localhost   (client, once `bin/phx-demo-ctl up` is running)
#   https://admin.phalanxduel.localhost  (admin UI, once `bin/phx-demo-ctl up` is running)
#   https://phalanxduel.localhost        (static site from phalanxduel/site)
#   https://phalanxduel.localhost/demo/  (generated local cockpit, when running)
#
# Installs the project-owned nginx vhost (nginx/phalanxduel.localhost.conf),
# mirroring just3ws.github.io/bin/install-localhost. Unlike that one, this
# proxies to live dev server ports instead of serving a static build, so
# there's nothing to build or sync here — just the vhost + cert + reload.
#
# Two steps still need YOUR system access (keychain / sudo); this script prints
# the exact commands rather than running privileged operations for you:
#   1. Add the new hostnames to the shared TLS cert's SAN list.
#   2. Reload nginx.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
VHOST_SRC="$REPO/nginx/phalanxduel.localhost.conf"
NGINX_PREFIX="/opt/homebrew/etc/nginx"
VHOST_DST="$NGINX_PREFIX/servers/phalanxduel.conf"
SITE_SRC="/Users/mike/github.com/phalanxduel/site/_site"
SITE_DST="/opt/homebrew/var/www/phalanxduel"
CERT="$NGINX_PREFIX/certs/zdots-local.pem"
HOSTS="phalanxduel.localhost play.phalanxduel.localhost admin.phalanxduel.localhost"

info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*"; }

[ -f "$VHOST_SRC" ] || { echo "missing $VHOST_SRC"; exit 1; }
[ -d "$NGINX_PREFIX/servers" ] || { echo "nginx not set up at $NGINX_PREFIX — run zdots bootstrap first"; exit 1; }
[ -d "$SITE_SRC" ] || { echo "missing built site export: $SITE_SRC"; exit 1; }

info "Installing vhost -> $VHOST_DST"
cp "$VHOST_SRC" "$VHOST_DST"
info "Publishing site export -> $SITE_DST"
mkdir -p "$SITE_DST"
cp -R "$SITE_SRC"/. "$SITE_DST"/
# The source checkout is intentionally owner-only. Normalize the disposable
# nginx publication copy without changing permissions in the source repo.
find "$SITE_DST" -type d -exec chmod 755 {} +
find "$SITE_DST" -type f -exec chmod 644 {} +

# Does the shared cert already cover all three hosts?
cert_ok=true
if [ -f "$CERT" ]; then
  sans="$(openssl x509 -in "$CERT" -noout -ext subjectAltName 2>/dev/null)"
  for h in $HOSTS; do
    grep -q "$h" <<<"$sans" || cert_ok=false
  done
else
  cert_ok=false
fi

echo
if [ "$cert_ok" = true ]; then
  info "TLS cert already covers: $HOSTS ✓"
else
  warn "TLS cert is missing one or more of: $HOSTS"
  info "zdots' nginx-regen-certs scans every deployed vhost's server_name, so with"
  info "this vhost now installed it will pick these up automatically (keychain prompt):"
  cat <<'EOF'

  nginx-regen-certs          # unions the new names into the cert, validates, reloads
  # or, to rebuild the SAN list purely from live vhosts:
  nginx-regen-certs --prune

EOF
fi

echo
info "If you regenerated the cert above, nginx was already reloaded. Otherwise:"
cat <<'EOF'

  # Repair the host-native nginx temp-path traversal/write permissions if the
  # error log contains client_body_temp or proxy_temp Permission denied.
  # The current Homebrew layout uses nobody for these worker-owned temp dirs.
  sudo chmod 755 /opt/homebrew/var/run/nginx
  sudo chown nobody:admin /opt/homebrew/var/run/nginx/client_body_temp /opt/homebrew/var/run/nginx/proxy_temp
  sudo chmod 700 /opt/homebrew/var/run/nginx/client_body_temp /opt/homebrew/var/run/nginx/proxy_temp

  nginx -t
  sudo launchctl kickstart -k system/homebrew.mxcl.nginx

  # (Do NOT use `sudo brew services restart nginx` — it takes root ownership
  #  of Homebrew paths. Kickstart is the zdots-blessed restart.)
EOF

echo
info "Then:  bin/phx-demo-ctl up"
info "       open https://play.phalanxduel.localhost"
info "       cockpit opens from bin/phx-demo-ctl -> https://phalanxduel.localhost/demo/"
info "       admin opens from the quicklinks page -> https://admin.phalanxduel.localhost"
