    body { max-width: 1120px; margin: 0 auto; padding: 2rem; background: radial-gradient(circle at top right, #4f8cff18, transparent 35rem); }
    h1 { margin-bottom: .25rem; } h2 { margin-top: 2rem; }
    .meta, small { color: #777; } .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
