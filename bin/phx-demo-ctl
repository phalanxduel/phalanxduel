#!/usr/bin/env bash
# Zero-anxiety control for a live Phalanx Duel demo session: start the
# server, client, and admin pair, wait until they're actually healthy (not
# just spawned), generate a local quicklinks page, and tear down cleanly.
# Built entirely on existing primitives (bin/services, scripts/dev-dashboard.ts,
# bin/maint/with-dev-postgres.sh) — no new infra.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# Load only non-secret local demo endpoint overrides. Production processes do
# not invoke this local rehearsal controller, and unrelated .env.local keys
# are intentionally excluded from its environment.
# shellcheck source=scripts/release/load-release-env.sh
source scripts/release/load-release-env.sh --sourced
load_local_demo_env

CLIENT_URL="${PHALANX_DEMO_CLIENT_URL:-http://localhost:5173}"
APP_URL="${PHALANX_DEMO_APP_URL:-http://localhost:3001}"
ADMIN_API_URL="${PHALANX_DEMO_ADMIN_API_URL:-http://localhost:3102}"
ADMIN_UI_URL="${PHALANX_DEMO_ADMIN_UI_URL:-http://localhost:3103}"
ADMIN_URL="${PHALANX_DEMO_ADMIN_URL:-$ADMIN_UI_URL}"
# The branded URL from nginx/phalanxduel.localhost.conf (bin/install-localhost),
# if it's set up on this machine — falls back to the raw dev port otherwise.
PLAY_URL="${PHALANX_DEMO_PLAY_URL:-$CLIENT_URL}"
READY_TIMEOUT="${PHALANX_DEMO_READY_TIMEOUT:-60}"
DEMO_RUNTIME_DIR="${PHALANX_DEMO_RUNTIME_DIR:-$REPO_ROOT/.phx/cockpit}"
QUICKLINKS_FILE="$DEMO_RUNTIME_DIR/quicklinks.html"
SERVICES_RUN_DIR="$REPO_ROOT/.phx/run"
SERVICES_LOG_DIR="$REPO_ROOT/.phx/logs"
COCKPIT_PORT="${PHALANX_DEMO_COCKPIT_PORT:-3333}"
COCKPIT_BRIDGE_URL="http://127.0.0.1:${COCKPIT_PORT}/"
COCKPIT_BRANDED_URL="${PHALANX_DEMO_BRANDED_URL:-https://phalanxduel.localhost/demo/}"
O2_URL="${PHALANX_DEMO_O2_URL:-http://localhost:5080}"
GRAFANA_URL="${PHALANX_DEMO_GRAFANA_URL:-http://localhost:3000}"
COCKPIT_URL="${PHALANX_DEMO_COCKPIT_URL:-$COCKPIT_BRANDED_URL}"
COCKPIT_PID_FILE="$SERVICES_RUN_DIR/cockpit.pid"
CLI_NAME="${PHX_CLI_NAME:-$(basename "$0")}"
GO_CLIENT_README="file://$REPO_ROOT/clients/go/duel-cli/README.md"
SWIFTUI_CLIENT_README="file://$REPO_ROOT/../game-swiftui/README.md"
if [ -f "$REPO_ROOT/../game-swiftui/README.md" ]; then
  SWIFTUI_CLIENT_CARD="<div class=\"card launch-card\"><a class=\"surface-link\" href=\"$SWIFTUI_CLIENT_README\">SwiftUI client ↗</a><small>Native client checkout · run <code>pnpm qa:swiftui:proof:watch</code></small></div>"
else
  SWIFTUI_CLIENT_CARD=""
fi

usage() {
  cat <<EOF
Usage: $CLI_NAME <command> [options]

Commands:
  up       Start server + client + admin (daemonized), wait, and open quicklinks.
  down     Stop server + client + admin.
  restart  Stop and start server + client + admin, wait for READY.
  status   One-shot health snapshot (pnpm dev:status).
  reset    Reseed the dev database to a clean state between rehearsals.
  logs     Tail server + client logs.
  links    Generate the local HTML quicklinks page and open it.
  restart-cockpit  Restart only the browser cockpit bridge (keeps game services up).
  cockpit  Open the interactive terminal development cockpit.

Options:
  --no-open  Print or generate the result without opening a browser.

Examples:
  $CLI_NAME up       # before the talk: start, wait, and open the cockpit page
  $CLI_NAME links --no-open
  $CLI_NAME cockpit  # headed terminal dashboard; Ctrl+C to exit
  $CLI_NAME reset    # between rehearsals: clean slate
  $CLI_NAME down     # after: stop everything
EOF
  exit "${1:-1}"
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  usage 0
fi

NO_OPEN=false
for arg in "$@"; do
  [ "$arg" = "--no-open" ] && NO_OPEN=true
done

service_pid() {
  local service=$1
  if [ -f "$SERVICES_RUN_DIR/$service.pid" ]; then
    cat "$SERVICES_RUN_DIR/$service.pid"
  else
    lsof -nP -tiTCP:"$(case "$service" in server) echo 3001;; client) echo 5173;; admin) echo 3102;; esac)" -sTCP:LISTEN 2>/dev/null | head -1 || true
  fi
}

service_state() {
  local service=$1
  local pid
  pid=$(service_pid "$service")
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "RUNNING"
  else
    echo "STOPPED"
  fi
}

probe_code() {
  local code
  code=$(curl -ksS -o /dev/null --max-time 2 -w '%{http_code}' "$1" 2>/dev/null || true)
  printf '%s' "${code:-000}"
}

probe_label() {
  local code=$1
  case "$code" in
    2*|3*|401|403) echo "reachable ($code)" ;;
    *) echo "not reachable ($code)" ;;
  esac
}

html_escape() {
  printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'
}

open_quicklinks() {
  start_cockpit_server
  COCKPIT_URL=$(cockpit_url)
  if [ "$NO_OPEN" = "true" ]; then
    return
  fi
  if command -v open >/dev/null 2>&1; then
    open "$COCKPIT_URL" >/dev/null 2>&1 || true
  else
    echo "   Browser opener unavailable. Open: $COCKPIT_URL"
  fi
}

start_cockpit_server() {
  if curl -fsS --max-time 1 "$COCKPIT_BRIDGE_URL/health" >/dev/null 2>&1; then
    return
  fi
  mkdir -p "$SERVICES_RUN_DIR" "$SERVICES_LOG_DIR"
  (
    cd "$REPO_ROOT"
    node scripts/demo-cockpit-server.mjs "$QUICKLINKS_FILE" "$SERVICES_LOG_DIR" "$COCKPIT_PORT" > "$SERVICES_LOG_DIR/cockpit.log" 2>&1 &
    echo $! > "$COCKPIT_PID_FILE"
  )
  for _ in 1 2 3 4 5; do
    curl -fsS --max-time 1 "$COCKPIT_BRIDGE_URL/health" >/dev/null 2>&1 && return
    sleep 1
  done
  echo "⚠️  Cockpit web server did not become ready. Open the static page: $QUICKLINKS_FILE" >&2
}

cockpit_url() {
  if [ -n "${PHALANX_DEMO_COCKPIT_URL:-}" ]; then
    printf '%s' "$PHALANX_DEMO_COCKPIT_URL"
  elif curl -kfsS --max-time 1 "$COCKPIT_BRANDED_URL" >/dev/null 2>&1; then
    printf '%s' "$COCKPIT_BRANDED_URL"
  else
    printf '%s' "$COCKPIT_BRIDGE_URL"
  fi
}

stop_cockpit_server() {
  if [ -f "$COCKPIT_PID_FILE" ]; then
    local pid
    pid=$(cat "$COCKPIT_PID_FILE")
    kill "$pid" 2>/dev/null || true
    rm -f "$COCKPIT_PID_FILE"
  fi
}

write_quicklinks() {
  start_cockpit_server
  mkdir -p "$(dirname "$QUICKLINKS_FILE")"
  COCKPIT_URL=$(cockpit_url)
  local generated_at git_commit app_code play_code admin_code api_code
  generated_at=$(date '+%Y-%m-%d %H:%M:%S %Z')
  git_commit=$(git rev-parse --short HEAD 2>/dev/null || echo unknown)
  app_code=$(probe_code "$APP_URL/health")
  play_code=$(probe_code "$PLAY_URL/")
  admin_code=$(probe_code "$ADMIN_URL")
  api_code=$(probe_code "$APP_URL/docs")

  local server_pid client_pid admin_pid
  server_pid=$(service_pid server)
  client_pid=$(service_pid client)
  admin_pid=$(service_pid admin)

  cat > "$QUICKLINKS_FILE" <<EOF
<!doctype html>
<html lang="en">
<head>
