  <h2>Demo sequence</h2>
  <ol>
    <li>Open the play link and let the Welcome dialog load.</li>
    <li>Use the admin link only for operator actions or match inspection.</li>
    <li>Play one attack, narrating Choose, Resolve, Rebuild, and Switch.</li>
    <li>If the branded host is unavailable, use <code>$(html_escape "$CLIENT_URL/")</code> as the local fallback.</li>
    <li>After rehearsal, run <code>phx-demo-ctl reset</code> for a clean seeded database.</li>
  </ol>

  <h2>Runtime map</h2>
  <div class="grid">
    <div class="card"><strong>Server</strong><br>PID: <code>$(html_escape "${server_pid:-not recorded}")</code><br>Port: <code>3001</code><br>Log: <code>$(html_escape "$SERVICES_LOG_DIR/server.log")</code><br>Status: $(service_state server)</div>
    <div class="card"><strong>Client</strong><br>PID: <code>$(html_escape "${client_pid:-not recorded}")</code><br>Port: <code>5173</code><br>Log: <code>$(html_escape "$SERVICES_LOG_DIR/client.log")</code><br>Status: $(service_state client)</div>
    <div class="card"><strong>Admin</strong><br>PID: <code>$(html_escape "${admin_pid:-not recorded}")</code><br>UI: <code>3103</code> · API: <code>3102</code><br>Log: <code>$(html_escape "$SERVICES_LOG_DIR/admin.log")</code><br>Status: $(service_state admin)</div>
  </div>
  <p><strong>Source:</strong> <code>$(html_escape "$REPO_ROOT")</code></p>
  <p><strong>Commands:</strong> <code>phx-demo-ctl cockpit</code> for the headed terminal dashboard, <code>phx-demo-ctl status</code> for JSON, <code>phx-demo-ctl logs</code> for logs, and <code>phx-demo-ctl down</code> to stop.</p>
  <h2 id="logs">Live log deck</h2>
  <div class="log-grid">
    <div class="log-card"><header><strong>Server</strong><a class="surface-link" href="file://$(html_escape "$SERVICES_LOG_DIR/server.log")">open file ↗</a></header><pre id="log-server">Connecting to server.log…</pre><small><code>tail -f $SERVICES_LOG_DIR/server.log</code></small></div>
    <div class="log-card"><header><strong>Client</strong><a class="surface-link" href="file://$(html_escape "$SERVICES_LOG_DIR/client.log")">open file ↗</a></header><pre id="log-client">Connecting to client.log…</pre><small><code>tail -f $SERVICES_LOG_DIR/client.log</code></small></div>
    <div class="log-card"><header><strong>Admin</strong><a class="surface-link" href="file://$(html_escape "$SERVICES_LOG_DIR/admin.log")">open file ↗</a></header><pre id="log-admin">Connecting to admin.log…</pre><small><code>tail -f $SERVICES_LOG_DIR/admin.log</code></small></div>
  </div>
  <script>
    (function () {
      var appHealthUrl = "api/probe/app-health";
      var appStatsUrl = "api/probe/app-stats";
      var adminHealthUrl = "api/probe/admin-health";
      var clientUrl = "api/probe/client";
      var maxPoints = 36;
      var history = [];
      var polling = true;

      document.querySelectorAll('a[href]').forEach(function (link) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      });

      function probe(url) {
        var started = performance.now();
        return fetch(url, { cache: 'no-store' }).then(function (response) {
          return response.text().then(function (body) {
            var data = {};
            try { data = JSON.parse(body); } catch (_) {}
            return { ok: response.ok, data: data, ms: Math.round(performance.now() - started) };
          });
        }).catch(function () {
          return { ok: false, data: {}, ms: null };
        });
      }

      function setText(id, value) { document.getElementById(id).textContent = value; }

      function refreshLogs() {
        ['server', 'client', 'admin'].forEach(function (service) {
          fetch('api/logs/' + service + '?lines=70', { cache: 'no-store' }).then(function (response) { return response.json(); }).then(function (payload) {
            var element = document.getElementById('log-' + service);
            element.textContent = payload.lines.join('\n');
            element.scrollTop = element.scrollHeight;
          }).catch(function () {
            document.getElementById('log-' + service).textContent = '[cockpit log bridge unavailable]';
          });
        });
      }

      function linePath(values, max, width, height, top) {
        if (!values.length) return '';
        return values.map(function (value, index) {
          var x = values.length === 1 ? width / 2 : index * width / (values.length - 1);
          var y = top + height - (value / Math.max(max, 1)) * height;
          return (index ? 'L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1);
        }).join(' ');
      }

      function renderActivity() {
        var svg = document.getElementById('activity-chart');
        var width = 760;
        var height = 160;
        var active = history.map(function (point) { return point.active; });
        var total = history.map(function (point) { return point.total; });
        var max = Math.max.apply(null, active.concat(total).concat([1]));
        var grid = [0, .25, .5, .75, 1].map(function (ratio) {
          var y = 15 + height - ratio * height;
          return '<line class="status-line" x1="0" y1="' + y + '" x2="760" y2="' + y + '"></line>';
        }).join('');
        svg.innerHTML = grid + '<polyline fill="none" stroke="#4f8cff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="' + linePath(active, max, width, height, 15).replace(/M|L/g, function (match) { return match === 'M' ? '' : ' '; }) + '"></polyline>' + '<polyline fill="none" stroke="#b276ff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="' + linePath(total, max, width, height, 15).replace(/M|L/g, function (match) { return match === 'M' ? '' : ' '; }) + '"></polyline>';
      }

      function renderHealth() {
        var svg = document.getElementById('health-chart');
        var services = ['app', 'admin', 'client', 'postgres'];
        var labels = ['App', 'Admin', 'Client', 'Postgres'];
        var rowHeight = 32;
        var left = 90;
        var plotWidth = 650;
        var cells = '<line class="status-line" x1="' + left + '" y1="0" x2="' + (left + plotWidth) + '" y2="0"></line>';
        services.forEach(function (service, row) {
          cells += '<text class="status-text" x="0" y="' + (row * rowHeight + 21) + '">' + labels[row] + '</text>';
          history.forEach(function (point, index) {
            var cellWidth = plotWidth / Math.max(history.length, 1);
            var color = point[service] ? '#2ec27e' : '#ff6b6b';
            cells += '<rect x="' + (left + index * cellWidth).toFixed(1) + '" y="' + (row * rowHeight + 5) + '" width="' + Math.max(cellWidth - 1, 2).toFixed(1) + '" height="20" rx="3" fill="' + color + '" opacity=".9"></rect>';
          });
        });
        svg.innerHTML = cells;
      }

      function refresh() {
        if (!polling) return;
        Promise.all([probe(appHealthUrl), probe(appStatsUrl), probe(adminHealthUrl), probe(clientUrl)]).then(function (results) {
          var app = results[0];
          var stats = results[1];
          var admin = results[2];
          var client = results[3];
          var active = Number(stats.data.activeMatches || 0);
          var total = Number(stats.data.totalMatches || 0);
          history.push({ active: active, total: total, app: app.ok, admin: admin.ok, client: client.ok, postgres: app.ok && stats.ok });
          if (history.length > maxPoints) history.shift();
          setText('metric-active', String(active));
          setText('metric-total', String(total));
          setText('metric-app-latency', app.ms === null ? 'DOWN' : app.ms + ' ms');
          setText('metric-admin-latency', admin.ms === null ? 'DOWN' : admin.ms + ' ms');
          setText('analytics-updated', 'updated ' + new Date().toLocaleTimeString());
          renderActivity();
          renderHealth();
        });
        refreshLogs();
      }

      document.getElementById('open-all').addEventListener('click', function () {
        document.querySelectorAll('.surface-link').forEach(function (link) { window.open(link.href, '_blank', 'noopener'); });
      });
      document.getElementById('refresh-now').addEventListener('click', refresh);
      document.getElementById('pause-telemetry').addEventListener('click', function () {
        polling = !polling;
        this.textContent = polling ? 'Pause polling' : 'Resume polling';
        if (polling) refresh();
      });
      window.setInterval(function () { document.getElementById('cockpit-clock').textContent = new Date().toLocaleTimeString(); }, 1000);
      refresh();
      window.setInterval(refresh, 2000);
    }());
  </script>
</body>
</html>
EOF
  echo "🔗 Quicklinks: $COCKPIT_URL"
  echo "   Static copy: $QUICKLINKS_FILE"
  echo "   Play:       $PLAY_URL/   ($(probe_label "$play_code"))"
  echo "   Admin:      $ADMIN_URL  ($(probe_label "$admin_code"))"
  echo "   App health: $APP_URL/health                    ($(probe_label "$app_code"))"
  echo "   API docs:   $APP_URL/docs                       ($(probe_label "$api_code"))"
  echo "   Source:     $REPO_ROOT"
  echo "   PIDs:       server=${server_pid:-unknown} client=${client_pid:-unknown} admin=${admin_pid:-unknown}"
  echo "   Logs:       $SERVICES_LOG_DIR/{server,client,admin}.log"
  open_quicklinks
}

wait_ready() {
  echo "⏳ Waiting for server + client + admin to report READY (up to ${READY_TIMEOUT}s)..."
  local waited=0
  while [ "$waited" -lt "$READY_TIMEOUT" ]; do
    local app_code client_code admin_code
    app_code=$(probe_code "$APP_URL/health")
    client_code=$(probe_code "$CLIENT_URL/")
    admin_code=$(probe_code "$ADMIN_API_URL/health")
    if [[ "$app_code" =~ ^2|3 ]] && [[ "$client_code" =~ ^2|3 ]] && [[ "$admin_code" =~ ^2|3 ]]; then
      echo "✅ Server, client, and admin are READY."
      write_quicklinks
      echo "   Logs:   phx-demo-ctl logs"
      echo "   Reset:  phx-demo-ctl reset"
      echo "   Stop:   phx-demo-ctl down"
      return 0
    fi
    sleep 2
    waited=$((waited + 2))
  done
  echo "❌ Not READY after ${READY_TIMEOUT}s (server=$app_code client=$client_code admin=$admin_code)."
  echo "   Check: phx-demo-ctl status   /   phx-demo-ctl logs"
  return 1
}

case "${1:-}" in
  up)
    bin/services start server -d
    bin/services start client -d
    bin/services start admin -d
    wait_ready
    ;;
  down)
    bin/services stop admin
    bin/services stop client
    bin/services stop server
    stop_cockpit_server
    ;;
  restart)
    echo "🔄 Restarting demo services..."
    bin/services stop admin
    bin/services stop client
    bin/services stop server
    bin/services start server -d
    bin/services start client -d
    bin/services start admin -d
    wait_ready
    ;;
  status)
    pnpm dev:status
    ;;
  reset)
    echo "🔄 Reseeding dev database..."
    pnpm admin:seed-dev
    echo "✅ Dev database reset to a clean seed."
    ;;
  logs)
    bin/services logs server client admin
    ;;
  links)
    write_quicklinks
    ;;
  restart-cockpit)
    stop_cockpit_server
    write_quicklinks
    ;;
  cockpit)
    exec pnpm dev:dashboard
    ;;
  *)
    usage
    ;;
esac
