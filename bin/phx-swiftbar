#!/usr/bin/env bash
# bin/phx-swiftbar — Phalanx Duel host-native demo pulse for SwiftBar.
#
# <swiftbar.name>Phalanx Duel Tournament Pulse</swiftbar.name>
# <swiftbar.version>v1.5.0</swiftbar.version>
# <swiftbar.author>Phalanx Duel Team</swiftbar.author>
# <swiftbar.author.github>phalanxduel</swiftbar.author.github>
# <swiftbar.desc>Live tournament network health, Wi-Fi RF quality, top bandwidth, and connected duelist socket state.</swiftbar.desc>
# <swiftbar.image>https://raw.githubusercontent.com/phalanxduel/game/main/client/public/images/card-back.svg</swiftbar.image>
# <swiftbar.dependencies>bash,curl,node,lsof</swiftbar.dependencies>
# <swiftbar.abouturl>https://github.com/phalanxduel/game</swiftbar.abouturl>
#
# Syntagma: the coordination pulse between the phalanx battle line and the
# zdots platform. Pure local consumption: probes configured demo endpoints,
# reads ignored .phx runtime/artifact paths, and emits SwiftBar menu syntax.
# It does not inspect databases, secrets, containers, or telemetry credentials.
# Install the thin refresh shim at ~/.swiftbar/phalanxduel-pulse.30s.sh.
#
# Usage: phx-swiftbar [--help]

set -uo pipefail

case "${1:-}" in
  -h|--help)
    sed -n '2,10p' "$0" | sed 's/^# *//'
    exit 0
    ;;
  ?*)
    echo "phx-swiftbar: unknown argument: $1" >&2
    exit 2
    ;;
esac

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Import only the PHALANX_DEMO_* URL/settings namespace. This is the same
# non-secret loader used by phx-demo-ctl, so SwiftBar follows the repo's
# configured branded/local surface instead of inventing localhost links.
# shellcheck source=scripts/release/load-release-env.sh
if [[ -r "$REPO_ROOT/scripts/release/load-release-env.sh" ]]; then
  # shellcheck disable=SC1091
  source "$REPO_ROOT/scripts/release/load-release-env.sh"
  # The helper returns the status of its optional local override file; a
  # missing override is normal for SwiftBar and must not abort the menu.
  load_local_demo_env || true
  # The loader enables errexit for deployment scripts; SwiftBar intentionally
  # continues after a down endpoint so it can render the complete menu.
  set +e
fi

# Defaults are deliberately host-native. Endpoint overrides remain available
# for a tunnel, nginx localhost aliases, or a different local port layout.
CLIENT_URL="${PHALANX_DEMO_CLIENT_URL:-http://localhost:5173}"
APP_URL="${PHALANX_DEMO_APP_URL:-http://localhost:3001}"
ADMIN_URL="${PHALANX_DEMO_ADMIN_URL:-http://localhost:3103}"
COCKPIT_URL="${PHALANX_DEMO_COCKPIT_URL:-http://127.0.0.1:${PHALANX_DEMO_COCKPIT_PORT:-3333}/}"
PLAY_URL="${PHALANX_DEMO_PLAY_URL:-$CLIENT_URL}"
O2_URL="${PHALANX_DEMO_O2_URL:-https://o2.localhost}"
JAEGER_URL="${PHALANX_DEMO_JAEGER_URL:-https://jaeger.localhost}"
LOG_DIR="${REPO_ROOT}/.phx/logs"
ARTIFACT_DIR="${REPO_ROOT}/artifacts"

probe() {
  local url="$1" code
  code="$(curl -ksS --max-time 2 -o /dev/null -w '%{http_code}' "$url" 2>/dev/null || true)"
  case "$code" in
    2*|3*|401|403) printf '%s' "$code"; return 0 ;;
    *) printf '%s' "000"; return 1 ;;
  esac
}

state_for() {
  case "$1" in
    2*|3*|401|403) printf 'READY' ;;
    *) printf 'DOWN' ;;
  esac
}

menu_url() {
  local label="$1" url="$2" color="${3:-white}"
  printf '%s | href=%s color=%s\n' "$label" "$url" "$color"
}

file_url() {
  local label="$1" path="$2" color="${3:-white}"
  if [[ -e "$path" ]]; then
    printf '%s | bash=/usr/bin/open param1="file://%s" terminal=false color=%s\n' "$label" "$path" "$color"
  else
    printf '%s | color=gray\n' "$label"
  fi
}

app_code="$(probe "$APP_URL/health")"
play_code="$(probe "$PLAY_URL/")"
admin_code="$(probe "$ADMIN_URL/")"
o2_code="$(probe "$O2_URL/")"
jaeger_code="$(probe "$JAEGER_URL/")"
docs_code="$(probe "http://localhost:3334/")"

# Tournament & LAN Live Telemetry (Something Interesting Detection)
lan_ip="$(ipconfig getifaddr en0 2>/dev/null || ifconfig en0 2>/dev/null | awk '/inet / {print $2; exit}' || true)"
resolved_ip="$(dscacheutil -q host -a name lan.phalanxduel.com 2>/dev/null | awk '/ip_address/ {print $2; exit}' || true)"

# Count active remote players connected to game ports (:3001, :5173)
active_sockets="$(lsof -nP -iTCP:3001,5173 -sTCP:ESTABLISHED 2>/dev/null | grep -v '127.0.0.1' | grep -v '\[::1\]' | awk 'END {print NR+0}')"
total_sockets="$(lsof -nP -iTCP:3001,5173 -sTCP:ESTABLISHED 2>/dev/null | awk 'END {print NR+0}')"

overall="🟢"
[[ "$app_code" == 000 || "$play_code" == 000 || "$admin_code" == 000 ]] && overall="🟠"
[[ "$app_code" == 000 && "$play_code" == 000 && "$admin_code" == 000 ]] && overall="🔴"

# SwiftBar dynamic header: surfaces "something interesting" immediately in the menu bar
if [[ "$active_sockets" -gt 0 ]]; then
  echo "⚔️ ${active_sockets} Duelists Live | color=#58a6ff"
elif [[ -n "$lan_ip" && -n "$resolved_ip" && "$lan_ip" != "$resolved_ip" ]]; then
  echo "⚠️ DNS Mismatch (${lan_ip}) | color=#d29922"
elif [[ "$overall" == "🔴" ]]; then
  echo "🔴 PHX Down | color=#f85149"
elif [[ "$overall" == "🟠" ]]; then
  echo "🟠 PHX Degraded | color=#d29922"
elif [[ -n "$lan_ip" ]]; then
  echo "🟢 PHX · $lan_ip"
else
  echo "$overall PHX"
fi

echo "---"
echo "Σύνταγμα / Syntagma · Phalanx Duel coordination pulse | size=14"
echo "Battle line ↔ trace timeline ↔ zdots | color=gray size=11"
echo "Host-native development · Docker/Colima not required | color=gray size=11"
echo "---"

app_state="$(state_for "$app_code")"
play_state="$(state_for "$play_code")"
admin_state="$(state_for "$admin_code")"
app_color=red; [[ "$app_code" != 000 ]] && app_color=green
play_color=red; [[ "$play_code" != 000 ]] && play_color=green
admin_color=red; [[ "$admin_code" != 000 ]] && admin_color=green
echo "API: $app_state ($app_code) | color=$app_color"
echo "Client: $play_state ($play_code) | color=$play_color"
echo "Admin: $admin_state ($admin_code) | color=$admin_color"
echo "---"

echo "Ἀγών / Agon · Tournament & LAN Status | size=13"
echo "  Active Host LAN IP: ${lan_ip:-127.0.0.1} | font=monospace"
if [[ -n "$lan_ip" && "$lan_ip" == "$resolved_ip" ]]; then
  echo "  DNS: *.lan.phalanxduel.com → $lan_ip (MATCHED) | color=green"
elif [[ -n "$lan_ip" && -n "$resolved_ip" ]]; then
  echo "  DNS: *.lan.phalanxduel.com → $resolved_ip (MISMATCH!) | color=orange"
  echo "  ↳ Action: Update A-record to $lan_ip | color=orange"
else
  echo "  DNS: *.lan.phalanxduel.com → UNRESOLVED | color=red"
fi

duel_badge="gray"; [[ "$active_sockets" -gt 0 ]] && duel_badge="#58a6ff"
echo "  Duelists: ${active_sockets} remote player sockets (${total_sockets} total) | color=$duel_badge"
echo "  ---"
menu_url "  LAN Player Arena ↗" "https://play.lan.phalanxduel.com" "$play_color"
menu_url "  LAN API Health ↗" "http://${lan_ip:-127.0.0.1}:3001/health" "$app_color"
docs_color=red; [[ "$docs_code" != 000 ]] && docs_color=green
menu_url "  Architecture & ERD Library ↗" "http://localhost:3334" "$docs_color"
echo "  ---"
echo "  Open Live Top Monitor | bash=$REPO_ROOT/bin/phx-tournament-top terminal=true"
echo "  Verify Ports Accessibility Matrix | bash=$REPO_ROOT/bin/phx-tournament-ports terminal=true"
echo "  Open Documentation Library | bash=$REPO_ROOT/bin/phx-docs-library param1=--open terminal=false"
echo "  Copy DNS A-Record | bash=/bin/sh param1=-c param2=\"echo '*.lan.phalanxduel.com 300 IN A ${lan_ip:-127.0.0.1}' | pbcopy\" terminal=false"
echo "---"

echo "Ἀγορά / Agora · live surfaces | size=13"
menu_url "  Play the game ↗" "$PLAY_URL" "$play_color"
menu_url "  Client UI ↗" "$CLIENT_URL" "$play_color"
menu_url "  Admin UI ↗" "$ADMIN_URL" "$admin_color"
menu_url "  API docs ↗" "$APP_URL/docs" "$app_color"
menu_url "  Demo cockpit ↗" "$COCKPIT_URL" "white"
echo "---"

echo "Observability | size=13"
o2_color=red; [[ "$o2_code" != 000 ]] && o2_color=green
jaeger_color=red; [[ "$jaeger_code" != 000 ]] && jaeger_color=green
echo "OpenObserve: $(state_for "$o2_code") ($o2_code) | color=$o2_color"
menu_url "  PHX dashboard ↗" "$O2_URL/web/dashboards/view?org_identifier=default&dashboard=7501905489362419712&folder=default&tab=default&refresh=Off&period=15m&print=false" "$o2_color"
menu_url "  Logs ↗" "$O2_URL/web/logs?stream_type=logs&stream=default&period=15m&refresh=0&org_identifier=default" "$o2_color"
menu_url "  Traces ↗" "$O2_URL/web/traces?org_identifier=default" "$o2_color"
echo "Jaeger: $(state_for "$jaeger_code") ($jaeger_code) | color=$jaeger_color"
menu_url "  Trace search ↗" "$JAEGER_URL/search" "$jaeger_color"
menu_url "  Service dependencies ↗" "$JAEGER_URL/dependencies" "$jaeger_color"
menu_url "  Service performance ↗" "$JAEGER_URL/monitor" "$jaeger_color"
echo "---"

echo "Ἰχνη / Ichni · PVL trails & QA evidence | size=13"
latest_report="$(ls -td "$ARTIFACT_DIR"/playthrough-*/*/scenario-report.md 2>/dev/null | head -1)"
if [[ -n "$latest_report" ]]; then
  latest_run="$(dirname "$latest_report")"
  file_url "Latest scenario report ↗" "$latest_report" green
  file_url "Panoramic View ↗" "$latest_run/panoramic-view.html" green
  file_url "Run manifest ↗" "$latest_run/manifest.json" green
else
  echo "No local PVL scenario report yet | color=gray"
fi
file_url "Artifacts directory ↗" "$ARTIFACT_DIR" gray
file_url "Server log ↗" "$LOG_DIR/server.log" gray
file_url "Client log ↗" "$LOG_DIR/client.log" gray
file_url "Admin log ↗" "$LOG_DIR/admin.log" gray
echo "---"

echo "Στρατηγός / Strategos · controls | size=13"
echo "Open demo status | bash=$REPO_ROOT/bin/phx-demo-ctl param1=status terminal=true refresh=true"
echo "Start / reconcile demo | bash=$REPO_ROOT/bin/phx-demo-ctl param1=up terminal=true refresh=true"
echo "Restart demo | bash=$REPO_ROOT/bin/phx-demo-ctl param1=restart terminal=true refresh=true"
echo "Tail demo logs | bash=$REPO_ROOT/bin/phx-demo-ctl param1=logs terminal=true"
echo "Stop demo | bash=$REPO_ROOT/bin/phx-demo-ctl param1=down terminal=true refresh=true"
echo "Refresh | refresh=true"
echo "---"

echo "ℹ️ About Phalanx Duel Pulse | size=13"
build_meta="$REPO_ROOT/build-metadata.json"
build_id="dev"
commit_sha="unknown"
if [[ -r "$build_meta" ]]; then
  build_id="$(node -e "try { console.log(JSON.parse(require('fs').readFileSync('$build_meta','utf8')).buildNumber || 'dev') } catch { console.log('dev') }" 2>/dev/null || echo "dev")"
  commit_sha="$(node -e "try { console.log((JSON.parse(require('fs').readFileSync('$build_meta','utf8')).commitSha || '').slice(0,7) || 'unknown') } catch { console.log('unknown') }" 2>/dev/null || echo "unknown")"
fi
if [[ "$commit_sha" == "unknown" ]]; then
  commit_sha="$(git -C "$REPO_ROOT" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
fi
echo "-- Version: v1.5.0 (Build: ${build_id}) | color=gray size=11"
echo "-- Commit: ${commit_sha} | color=gray size=11"
echo "-- Architecture: Deterministic TS Engine · Fastify · Vite · OTel | color=gray size=11"
echo "-- Host LAN IP: ${lan_ip:-127.0.0.1} | color=gray size=11 font=monospace"
echo "-- ---"
echo "-- 📖 Tournament Runbook & Playbook | bash=/usr/bin/open param1=\"$REPO_ROOT/docs/ops/TOURNAMENT_RUNBOOK.md\" terminal=false size=11"
echo "-- 🎮 Open Game Top (phx-top) | bash=$REPO_ROOT/bin/phx-top terminal=true size=11"
echo "-- 📡 Open Network Top (phx-tournament-top) | bash=$REPO_ROOT/bin/phx-tournament-top terminal=true size=11"
echo "-- 🩺 Run Diagnostic Checks (phx-tournament-check) | bash=$REPO_ROOT/bin/phx-tournament-check terminal=true size=11"
echo "-- 📚 Architecture Library SPA | bash=$REPO_ROOT/bin/phx-docs-library param1=--open terminal=false size=11"
echo "-- 🌐 GitHub Repository (phalanxduel/game) | href=https://github.com/phalanxduel/game size=11"

