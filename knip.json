{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,mjs}"],
      "project": ["scripts/**/*.{ts,mjs}"]
    },
    "shared": {
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "engine": {
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "server": {
      "entry": ["scripts/**/*.ts", "tests/perf/**/*.bench.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
    },
    "client": {
      "project": ["src/**/*.ts", "src/**/*.tsx"]
    },
    "admin": {
      "project": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
    },
    "mcp": {
      "entry": ["demo-llama.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": [
    "bin/qa/bootstrap.zsh",
    "bin/dock",
    "bin/phx-datalake",
    "bin/phx-fix",
    "groma",
    "graphify",
    "go",
    "k6",
    "psql",
    "pg_dump",
    "diff",
    "flyctl",
    "gh",
    "fly",
    "docker-compose",
    "readlink",
    "which",
    "netstat",
    "networksetup",
    "lsof",
    "route",
    "ip"
  ],
  "ignoreDependencies": [
    "dependency-cruiser",
    "pino-pretty",
    "@openapitools/openapi-generator-cli",
    "undici"
  ],
  "ignoreExportsUsedInFile": true
}
