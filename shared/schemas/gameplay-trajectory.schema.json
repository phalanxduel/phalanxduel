                  },
                  "matchParams": {
                    "type": "object",
                    "properties": {
                      "specVersion": {
                        "type": "string",
                        "enum": [
                          "1.0",
                          "2.0",
                          "3.0"
                        ],
                        "description": "Rules semantics version. 1.0 preserves historical behavior; 2.0 preserves corrected combat before liveness draws; 3.0 is the current competitive ruleset."
                      },
                      "classic": {
                        "type": "object",
                        "properties": {
                          "enabled": {
                            "type": "boolean",
                            "description": "Whether Classic schema binding is active (§3.1)."
                          },
                          "mode": {
                            "default": "strict",
                            "type": "string",
                            "enum": [
                              "strict",
                              "hybrid"
                            ],
                            "description": "Classic schema binding mode (§3.1). strict: all top-level parameters must exactly match the classic template. hybrid: classic values serve as defaults, top-level may override within Global System Constraints."
                          },
                          "battlefield": {
                            "type": "object",
                            "properties": {
                              "rows": {
                                "default": 2,
