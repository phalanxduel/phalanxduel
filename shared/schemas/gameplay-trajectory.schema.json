                                "type": "integer",
                                "minimum": 1,
                                "maximum": 12
                              },
                              "columns": {
                                "default": 4,
                                "description": "Number of columns per player board. Default: 4. Max: 12 (§3.3).",
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 12
                              }
                            },
                            "required": [
                              "rows",
                              "columns"
                            ],
                            "additionalProperties": false
                          },
                          "hand": {
                            "type": "object",
                            "properties": {
                              "maxHandSize": {
                                "default": 4,
