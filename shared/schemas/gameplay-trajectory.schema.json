                      "damageMode": {
                        "default": "classic",
                        "description": "Compatibility-only runtime override. Canonical v2.0 rule authority belongs to match params `modeDamagePersistence`, not `gameOptions.damageMode`.",
                        "type": "string",
                        "enum": [
                          "classic",
                          "cumulative"
                        ]
                      },
                      "startingLifepoints": {
                        "default": 20,
                        "description": "Compatibility-only runtime override for bootstrap surfaces. Canonical v2.0 gameplay is defined by the match params contract, not `gameOptions.startingLifepoints`.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 500
                      },
                      "classicDeployment": {
                        "default": true,
                        "description": "Compatibility-only runtime override for deployment bootstrap. Canonical v2.0 rule authority belongs to `modeClassicDeployment` in the match params.",
                        "type": "boolean"
                      },
                      "quickStart": {
                        "description": "Compatibility-only bootstrap shortcut. If true, runtime may skip deployment and pre-fill the battlefield, but canonical v2.0-compliant matches keep this disabled.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "damageMode",
                      "startingLifepoints",
                      "classicDeployment"
                    ],
                    "additionalProperties": false
