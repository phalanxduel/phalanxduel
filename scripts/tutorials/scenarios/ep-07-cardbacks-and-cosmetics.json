        {
          "action": "registerDemo"
        },
        {
          "action": "click",
          "selector": "a[href=\"?screen=settings\"]"
        }
      ]
    },
    {
      "id": "preview-skins",
      "label": "Read the skin states",
      "actions": [
        {
          "action": "highlight",
          "selector": ".cosmetic-loadout-card[data-card-theme=\"dual-loop\"]"
        }
      ],
      "expect": ".cosmetic-loadout-card[data-card-theme=\"dual-loop\"]",
      "focus": [".cosmetic-loadout-card[data-card-theme=\"dual-loop\"]"],
      "holdMs": 2200
    },
    {
      "id": "equip-after-match",
      "label": "Finish a match and equip Dual Loop",
      "actions": [
        {
          "action": "click",
          "selector": ".cosmetic-loadout-card[data-card-theme=\"dual-loop\"][data-state=\"owned\"] button"
