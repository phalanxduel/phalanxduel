      ],
      "expect": ".cosmetic-loadout-card[data-card-theme=\"dual-loop\"][data-state=\"equipped\"]",
      "focus": [".cosmetic-loadout-card[data-card-theme=\"dual-loop\"]"],
      "holdMs": 2200,
