  "cues": [
    {
      "id": "match-intro",
      "label": "Launch the hard MCTS opponent",
      "actions": [
        {
          "action": "highlight",
          "selector": "[data-testid=\"hand\"]"
        }
      ],
      "expect": "[data-testid=\"hand\"]",
      "focus": ["[data-testid=\"hand\"]"],
      "holdMs": 2200,
      "setup": [
        {
          "action": "goto",
          "urlPath": "/"
        },
        {
          "action": "quickStart",
          "selector": "lobby-bot-btn-mcts-hard"
        }
      ]
    },
    {
      "id": "opening-formation",
      "label": "Deploy the opening formation",
      "actions": [
        {
          "action": "deployFirstCard"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"quick-deploy-aggressive\"]"
        }
      ],
      "expect": "[data-testid=\"player-battlefield\"] .attack-playable",
      "focus": ["[data-testid=\"player-battlefield\"]", "[data-testid=\"opponent-battlefield\"]"],
      "holdMs": 2200
    },
    {
      "id": "midgame-pivot",
      "label": "Resolve and inspect an attack",
      "actions": [
        {
          "action": "attack"
        },
        {
          "action": "click",
          "selector": "[data-attack-owner=\"player\"] [data-testid=\"combat-math-log\"] button:text-is(\"ANALYST\")"
        }
      ],
      "expect": "[data-attack-owner=\"player\"] [data-testid=\"combat-math-log\"][data-mode=\"analyst\"]",
      "focus": ["[data-attack-owner=\"player\"] [data-testid=\"combat-math-log\"]"],
      "holdMs": 2200
    },
    {
      "id": "endgame-verify",
      "label": "Review the completed match",
      "actions": [
        {
          "action": "finishMatch",
          "value": "show"
        }
      ],
      "expect": "[data-testid=\"game-over-result\"]",
      "focus": ["[data-testid=\"game-over-result\"]"],
      "holdMs": 2200
    }
  ]
