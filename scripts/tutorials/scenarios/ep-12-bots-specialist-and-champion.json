  "tags": ["Phalanx Duel", "Bots", "MCTS", "MCTS Easy", "MCTS Medium", "MCTS Hard", "Tutorial"],
  "summary": "Find the MCTS difficulty choices, start a Hard match, and inspect its opening combat.",
  "cues": [
    {
      "id": "specialist-intro",
      "label": "Find the MCTS choices",
      "actions": [
        {
          "action": "goto",
          "urlPath": "/"
        },
        {
          "action": "highlight",
          "selector": "[data-testid=\"lobby-bot-btn-mcts-hard\"]"
        }
      ],
      "expect": "[data-testid=\"lobby-bot-btn-mcts-hard\"]",
      "focus": [".solo-section"],
      "holdMs": 2200
    },
    {
      "id": "champion-boss",
      "label": "Launch MCTS Hard",
      "actions": [
        {
          "action": "quickStart",
          "selector": "lobby-bot-btn-mcts-hard"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"quick-deploy-aggressive\"]"
        }
      ],
      "expect": "[data-testid=\"player-battlefield\"] .attack-playable",
      "focus": ["[data-testid=\"player-battlefield\"]", "[data-testid=\"opponent-battlefield\"]"],
      "holdMs": 2200
    },
    {
      "id": "combat-reply",
      "label": "Inspect a real attack",
      "actions": [
        {
          "action": "attack"
        },
        {
          "action": "click",
          "selector": "[data-attack-owner=\"player\"] [data-testid=\"combat-math-log\"] button:text-is(\"ANALYST\")"
        }
      ],
      "expect": "[data-attack-owner=\"player\"] [data-testid=\"combat-math-log\"][data-mode=\"analyst\"]",
      "focus": ["[data-attack-owner=\"player\"] [data-testid=\"combat-math-log\"]"],
      "holdMs": 2200
    }
  ]
