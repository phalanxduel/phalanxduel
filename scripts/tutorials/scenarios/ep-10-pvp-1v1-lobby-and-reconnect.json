{
  "version": 1,
  "id": "ep-10-pvp-1v1-lobby-and-reconnect",
  "season": 3,
  "episodeNumber": 10,
  "title": "Create, Join, and Reconnect to a Private Duel",
  "format": "16:9",
  "targetDurationSec": 21,
  "mode": "classic",
  "startingLp": 12,
  "seed": 42010,
  "cardSkinId": "default",
  "playerName": "TutorialHost",
  "companionUrl": "https://phalanxduel.com/learn/first-match/",
  "tags": ["Phalanx Duel", "PvP", "1v1", "Multiplayer", "Reconnect", "Tutorial"],
  "summary": "Create an invitation, join from a second browser, and refresh to recover the same match.",
  "cues": [
    {
      "id": "create-pvp",
      "label": "Create a private match",
      "actions": [
        {
          "action": "goto",
          "urlPath": "/"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"lobby-name-input\"]",
          "value": "TutorialHost"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"lobby-create-btn\"]"
        }
      ],
      "expect": "[data-testid=\"waiting-match-id\"]",
      "focus": [".waiting-grid"],
      "holdMs": 2200
    },
    {
      "id": "invite-and-join",
      "label": "Join from a second browser",
      "actions": [
        {
          "action": "joinOpponent"
        }
      ],
      "expect": "[data-testid=\"game-layout\"]",
      "focus": ["[data-testid=\"player-battlefield\"]", "[data-testid=\"opponent-battlefield\"]"],
      "holdMs": 2200
    },
    {
      "id": "reconnect-proof",
      "label": "Refresh and recover",
      "actions": [
        {
          "action": "reconnect"
        }
      ],
      "expect": "[data-testid=\"game-layout\"]",
      "focus": ["[data-testid=\"player-battlefield\"]", "[data-testid=\"opponent-battlefield\"]"],
      "holdMs": 2200
    }
  ]
}
