{
  "version": 1,
  "id": "ep-16-spectator-mode",
  "season": 5,
  "episodeNumber": 16,
  "title": "Watch a Duel from Spectator Mode",
  "format": "9:16",
  "targetDurationSec": 17,
  "mode": "classic",
  "startingLp": 12,
  "seed": 42016,
  "cardSkinId": "default",
  "playerName": "TutorialHost",
  "companionUrl": "https://phalanxduel.com/competitive/",
  "tags": ["Phalanx Duel", "Spectator Mode", "Watch Live", "Esports", "Shorts"],
  "summary": "Open the delayed spectator view and find the live director and play-by-play.",
  "cues": [
    {
      "id": "watch-link",
      "label": "Open a match as an observer",
      "actions": [
        {
          "action": "highlight",
          "selector": "[data-testid=\"spectator-banner\"]"
        }
      ],
      "expect": "[data-testid=\"spectator-banner\"]",
      "focus": ["[data-testid=\"player-battlefield\"]", "[data-testid=\"opponent-battlefield\"]"],
      "holdMs": 2200,
      "setup": [
        {
          "action": "goto",
          "urlPath": "/"
        },
        {
          "action": "quickStart"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"quick-deploy-aggressive\"]"
        },
        {
          "action": "waitForSelector",
          "selector": "[data-testid=\"player-battlefield\"] .attack-playable"
        },
        {
          "action": "attack"
        },
        {
          "action": "watchMatch"
        }
      ]
    },
    {
      "id": "redaction-fairness",
      "label": "Check the hidden hands",
      "actions": [
        {
          "action": "highlight",
          "selector": "[data-testid=\"engagement-log\"]"
        }
      ],
      "expect": "[data-testid=\"spectator-live-panel\"]",
      "focus": ["[data-testid=\"engagement-log\"]", "[data-testid=\"spectator-live-panel\"]"],
      "holdMs": 2200
    }
  ]
}
