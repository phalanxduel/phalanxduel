{
  "version": 1,
  "id": "ep-17-playing-in-a-tournament",
  "season": 5,
  "episodeNumber": 17,
  "title": "Rehearse a Tournament Table",
  "format": "16:9",
  "targetDurationSec": 25,
  "mode": "classic",
  "startingLp": 12,
  "seed": 42017,
  "cardSkinId": "obsidian-heraldry",
  "playerName": "TutorialHost",
  "companionUrl": "https://phalanxduel.com/competitive/",
  "tags": ["Phalanx Duel", "Tournament", "LAN", "Competitive", "Tutorial"],
  "summary": "Overview of local LAN tournament play on play.lan.phalanxduel.com: create a private venue table, seat your opponent via invite code, and make an opening move with spectator-ready deterministic replay.",
  "cues": [
    {
      "id": "lan-connect",
      "label": "Create a practice table",
      "actions": [
        {
          "action": "goto",
          "urlPath": "/"
        },
        {
          "action": "fill",
          "selector": "[data-testid=\"lobby-name-input\"]",
          "value": "TutorialHost"
        },
        {
          "action": "click",
          "selector": "[data-testid=\"lobby-create-btn\"]"
        }
      ],
      "expect": "[data-testid=\"waiting-match-id\"]",
      "focus": [".waiting-grid"],
      "holdMs": 2200
    },
    {
      "id": "bracket-play",
      "label": "Seat the other player",
      "actions": [
        {
          "action": "joinOpponent",
          "value": "ensurePlayerTurn"
        }
      ],
      "expect": "[data-testid=\"game-layout\"]",
      "focus": ["[data-testid=\"player-battlefield\"]", "[data-testid=\"opponent-battlefield\"]"],
      "holdMs": 2200
    },
    {
      "id": "first-move",
      "label": "Play the opening card",
      "actions": [
        {
          "action": "deployFirstCard"
        }
      ],
      "expect": "[data-testid=\"player-battlefield\"] [data-row=\"0\"].occupied",
      "focus": ["[data-testid=\"player-battlefield\"]", "[data-testid=\"hand\"]"],
      "holdMs": 2200
    }
  ]
}
